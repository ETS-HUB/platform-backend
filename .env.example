# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ets_platform?schema=public"

# JWT
JWT_SECRET="your-jwt-secret-change-in-production"
JWT_EXPIRATION="7d"

# AI (Google Gemini)
GEMINI_API_KEY="your-gemini-api-key"

# Brevo (Email)
BREVO_API_KEY="your-brevo-api-key"
