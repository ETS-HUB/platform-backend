# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ets_platform?schema=public"

# JWT
JWT_SECRET="your-jwt-secret-change-in-production"
JWT_EXPIRATION="7d"

# AI (Google Gemini)
GEMINI_API_KEY="your-gemini-api-key"

# Brevo (Email)
BREVO_API_KEY="your-brevo-api-key"
MAIL_FROM_EMAIL="noreply@ets-platform.com"
MAIL_FROM_NAME="ETS Platform"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="https://production.etshub.org/api/auth/google/callback"


CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:3001"
